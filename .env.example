APP_NAME=aide-bot
APP_ENV=local
LOG_LEVEL=INFO

MAX_BOT_TOKEN=
MAX_API_BASE_URL=https://platform-api2.max.ru/
MAX_REQUEST_TIMEOUT=45s
MAX_POLLING_PAUSE=500ms
MAX_POLLING_TIMEOUT=30s

